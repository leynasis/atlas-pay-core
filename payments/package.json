{
  "name": "lavepay-lab",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "LAVEPAY local devnet payments with separate customer and merchant signing wallets",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "network:install": "node network/install.mjs",
    "network:start": "node network/start.mjs",
    "network:status": "node network/status.mjs",
    "network:stop": "node network/stop.mjs",
    "lab:start": "node lab/start.mjs",
    "lab:status": "node lab/status.mjs",
    "lab:stop": "node lab/stop.mjs",
    "lab:mine": "node lab/mine.mjs",
    "signer:request": "node signer/merchant-request.mjs",
    "signer": "node signer/cli.mjs",
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node start.mjs",
    "start:dev": "ATLAS_DEV_ORIGIN=http://127.0.0.1:5173 node start.mjs",
    "start:merchant": "node start.mjs merchant",
    "start:customer-wallet": "node wallet/index.mjs customer",
    "start:merchant-wallet": "node wallet/index.mjs merchant",
    "legacy:api": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs masternodes/*.test.mjs",
    "test:integration": "node tests/checkout-integration.mjs",
    "test:legacy": "node tests/integration.mjs",
    "test:lab": "node tests/lab-integration.mjs",
    "test:signer": "node tests/signer-integration.mjs",
    "format": "prettier --write start.mjs \"{core,server,network,lab,signer,merchant,wallet,backup,isolation,masternodes,tests}/**/*.mjs\" \"web/src/**/*.{js,jsx,css}\" web/vite.config.js",
    "check:format": "prettier --check start.mjs \"{core,server,network,lab,signer,merchant,wallet,backup,isolation,masternodes,tests}/**/*.mjs\" \"web/src/**/*.{js,jsx,css}\" web/vite.config.js",
    "demo": "npm run lab:start && npm run build && npm start",
    "core:build": "node core/build.mjs",
    "core:verify": "node core/verify.mjs",
    "core:test": "node core/test.mjs",
    "test:wallet-isolation": "node tests/wallet-isolation.mjs",
    "mn:start": "node masternodes/index.mjs start",
    "mn:status": "node masternodes/index.mjs status",
    "mn:mine": "node masternodes/index.mjs mine",
    "mn:verify": "node masternodes/index.mjs verify",
    "mn:stop": "node masternodes/index.mjs stop",
    "backup": "node backup/cli.mjs",
    "test:isolation": "node tests/isolation-integration.mjs",
    "test:backup": "node tests/backup-integration.mjs",
    "test:cashier": "node tests/cashier-integration.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "vite": "^7.0.0"
  }
}
