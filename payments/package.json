{
  "name": "atlas-pay-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dash-based payment workspace with real isolated regtest transactions",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "network:install": "node network/install.mjs",
    "network:start": "node network/start.mjs",
    "network:status": "node network/status.mjs",
    "network:stop": "node network/stop.mjs",
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.mjs",
    "start:dev": "ATLAS_DEV_ORIGIN=http://127.0.0.1:5173 node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "format": "prettier --write \"{server,network,tests}/**/*.mjs\" \"web/src/**/*.{jsx,css}\" web/vite.config.js",
    "check:format": "prettier --check \"{server,network,tests}/**/*.mjs\" \"web/src/**/*.{jsx,css}\" web/vite.config.js",
    "demo": "npm run network:start && npm run build && npm start"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "vite": "^7.0.0"
  }
}
